{
  "name": "fintech-crypto-trading-zerohue-mobile-testing",
  "version": "1.0.0",
  "description": "Mobile web automation framework for the ZeroHue crypto paper-trading SPA, driving iPhone 17 Safari (XCUITest) and Samsung Galaxy Chrome (UiAutomator2) via WebdriverIO + Appium 2.",
  "private": true,
  "type": "module",
  "scripts": {
    "test:ios": "wdio run wdio.ios.conf.ts",
    "test:android": "wdio run wdio.android.conf.ts",
    "test:both": "npm run test:android && npm run test:ios",
    "test:ios:single": "wdio run wdio.ios.conf.ts --spec",
    "test:android:single": "wdio run wdio.android.conf.ts --spec",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report"
  },
  "dependencies": {
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/local-runner": "^9.31.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "@wdio/types": "^9.0.0",
    "appium": "^2.11.0",
    "appium-uiautomator2-driver": "^4.0.0",
    "appium-xcuitest-driver": "^7.0.0",
    "expect-webdriverio": "^4.0.0",
    "webdriverio": "^9.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
